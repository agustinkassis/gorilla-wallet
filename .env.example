# Every variable is optional: with an empty .env the app runs on these defaults,
# the first Nostr login claims it, and you create or import wallets in the browser.

# Optional default wallet (BIP39 words). Server-only: never sent to the browser or written to the database.
SEED_PHRASE=
DERIVATION_PATH="m/84'/0'/0'"

# Optional comma-separated npub/hex keys allowed to log in. Without it, the first login becomes the owner
# and more keys can be allowed in Settings → Access.
ALLOWED_PUBKEYS=

# Electrum/Fulcrum servers, comma-separated, tried in order (failover): tcp://host:port or ssl://host:port
BTC_ELECTRUM=ssl://electrum.blockstream.info:50002
XBT_ELECTRUM=tcp://fulcrum.kilombino.com:17717,tcp://electrum.marcanotrades.com:4142
# ssl:// certificates are verified; list hosts with a self-signed certificate you trust (e.g. your own node)
ELECTRUM_SELF_SIGNED=

# Mempool instances: fee estimates, broadcast, explorer links
MEMPOOL_BTC_URL=https://mempool.space
MEMPOOL_XBT_URL=https://mempool.kilombino.com
# Any chain in lib/chains.ts works the same way: TBTC4_ELECTRUM, TBTC3_ELECTRUM, SIGNET_ELECTRUM, MEMPOOL_TBTC4_URL, …
# (Settings → Networks overrides these per chain.)

# Regtest has no public defaults. Point these to your local test stack.
REGTEST_ELECTRUM=
MEMPOOL_REGTEST_URL=

# Local SQLite database (wallets, UTXOs, txs, labels, settings)
# DATABASE_URL=file:./data/wallet.db
