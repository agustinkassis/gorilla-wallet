// Local wallet cache + user metadata. Chain-scoped rows use the chain ids of lib/chains.ts ("btc", "xbt", "tbtc4", …).
// Values are satoshis (BigInt). Electrum stays the source of truth; this is a warm, indexed cache.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A wallet: the .env seed (kind "env"), a software wallet created/imported in the app ("seed"),
/// or a watch-only xpub ("watch"). Software seeds are stored encrypted with the wallet's password.
model Wallet {
  id          String   @id
  name        String
  kind        String // env | seed | watch
  /// seed wallets: JSON {mnemonic, passphrase} sealed with the wallet password (scrypt + AES-256-GCM), or kdf "none" without one
  encSeed     String?
  /// a BIP39 passphrase is part of this wallet (shown in the UI, never stored in clear)
  passphrase  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// A wallet's account key per family of chains (main: coin type 0', test: 1'). xpub stored with mainnet version bytes.
model WalletAccount {
  walletId    String
  family      String // main | test
  xpub        String
  path        String
  fingerprint Int

  @@id([walletId, family])
}

/// Current receive address, shared by all chains in the wallet's network family.
model ReceiveCursor {
  walletId String
  family   String
  index    Int    @default(0)

  @@id([walletId, family])
}

/// Addresses derived from a wallet's account on a family (shared by that family's chains, e.g. Bitcoin and Blake).
model Address {
  walletId   String
  family     String @default("main")
  address    String
  change     Int // 0 = receive, 1 = change
  index      Int
  scripthash String

  @@id([walletId, address])
  @@unique([walletId, family, scripthash])
  @@unique([walletId, family, change, index])
}

/// Per-chain sync state of an address. `status` is the Electrum status hash: unchanged => skip resync.
model AddressState {
  walletId    String
  chain       String
  address     String
  status      String?
  used        Boolean @default(false)
  confirmed   BigInt  @default(0)
  unconfirmed BigInt  @default(0)
  /// JSON [[txid, height], ...] from the last get_history: lets us GC replaced/evicted txs without refetching everything
  history     String  @default("[]")

  @@id([walletId, chain, address])
  @@index([walletId, chain, used])
}

model Utxo {
  walletId String
  chain    String
  txid     String
  vout     Int
  address  String
  value    BigInt
  height   Int // <= 0 while unconfirmed

  @@id([walletId, chain, txid, vout])
  @@index([walletId, chain, address])
}

/// Wallet transactions (net effect on our addresses).
model Tx {
  walletId String
  chain    String
  txid     String
  height   Int
  time     Int?
  amount   BigInt
  fee      BigInt?
  vsize    Int?

  @@id([walletId, chain, txid])
  @@index([walletId, chain, height])
}

/// Immutable raw transaction cache (wallet txs and their parents).
model RawTx {
  chain String
  txid  String
  hex   String

  @@id([chain, txid])
}

/// Block timestamp cache.
model Header {
  chain  String
  height Int
  time   Int

  @@id([chain, height])
}

/// BIP-329 style labels. type: tx | addr | output (ref "txid:vout"). spendable=false => frozen.
model Label {
  walletId  String
  chain     String
  type      String
  ref       String
  label     String?
  spendable Boolean?

  @@id([walletId, chain, type, ref])
}

model Setting {
  key   String @id
  value String // JSON
}

/// Consumed NIP-98 writes. Expired rows are removed on the next authorized write.
model AuthEvent {
  id        String @id
  expiresAt Int

  @@index([expiresAt])
}

/// Unattended forwarding: every run sweeps the confirmed coins of `fromAddress` (a wallet address) to `toAddress`,
/// with an OP_RETURN (`message`, or 90 fresh random bytes when null). Scheduled by a crontab block per rule.
model ForwardRule {
  id            String    @id
  walletId      String
  chain         String
  fromAddress   String
  toAddress     String
  everyMinutes  Int
  minConf       Int       @default(1)
  /// sat/vB: a network estimate above it skips the run until the next one
  maxFeeRate    Float
  message       String?
  /// absolute path of the wallet password file (encrypted wallets only)
  passwordFile  String?
  /// the crontab command installed for this rule
  cronLine      String
  logFile       String
  createdAt     DateTime  @default(now())
  lastCheckedAt DateTime?
  /// lease held by the run in progress: overlapping cron runs exit without doing anything
  runningUntil  DateTime?
}

/// Forward runs that did something (sent, skipped or failed); idle checks only update lastCheckedAt.
model ForwardRun {
  id        Int      @id @default(autoincrement())
  ruleId    String
  startedAt DateTime @default(now())
  status    String // sent | skipped | error
  reason    String?
  txid      String?
  amount    BigInt?
  fee       BigInt?
  feeRate   Float?
  /// JSON [{txid, vout, value}]
  inputs    String   @default("[]")
  dataHex   String?

  @@index([ruleId, startedAt])
}
