# dependencies
/node_modules
/.pnp
.pnp.*

# next.js / build output
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# secrets: never commit the seed or keys
.env
.env.*
!.env.example
*.pem
*.key

# local wallet database (SQLite cache: UTXOs, txs, labels, settings)
/data/
*.db
*.db-journal
*.db-shm
*.db-wal

# desktop (Tauri) build output: Rust target, bundled server and Node sidecar (scripts/desktop.mjs)
/src-tauri/target/
/src-tauri/server/
/src-tauri/binaries/
/src-tauri/gen/

# generated Prisma client (rebuilt by `pnpm install` → postinstall)
/lib/generated/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor / OS / local tooling
.DS_Store
.vscode/
.idea/
.claude/
.vercel

# social images, regenerated per release (pnpm social, docs/SOCIAL.md)
/social/
