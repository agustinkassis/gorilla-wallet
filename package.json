{
  "name": "gorilla-wallet",
  "version": "0.1.1",
  "private": true,
  "bin": {
    "gorila": "bin/gorila.mjs"
  },
  "scripts": {
    "dev": "prisma migrate deploy && next dev -H 127.0.0.1",
    "build": "next build",
    "start": "prisma migrate deploy && next start -H 127.0.0.1",
    "lint": "eslint",
    "check:cli": "node scripts/check-cli-all.mjs",
    "check": "DATABASE_URL=file:./data/check.db prisma migrate deploy >/dev/null && DATABASE_URL=file:./data/check.db tsx --conditions=react-server scripts/check.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "tauri": "tauri",
    "check:cli:regtest": "node scripts/check-cli-regtest.mjs"
  },
  "dependencies": {
    "@ngraveio/bc-ur": "^1.1.13",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "bbqr": "^1.2.0",
    "better-sqlite3": "^12.11.1",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "nostr-tools": "^2.25.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@tauri-apps/cli": "^2.12.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
